# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model slug. The PartyRock original used Claude Sonnet 5.
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# PORT=3000
# Set HOST=0.0.0.0 when deploying behind a host that needs all interfaces.
# HOST=127.0.0.1
# APP_URL=http://localhost:3000
